#!/usr/bin/env ruby
# frozen_string_literal: true

# safe-to-leave -- report what a finished story has left behind in a
# repository, so the developer can see it before closing the session.
#
# It prints one or more lines per check and changes nothing: it reads
# the working tree, the commits the remote does not have, the stashes,
# and the linked worktrees. The remote is asked which branch is its
# default, and that is the one use of the network. Each line carries
# one of four words:
#
#   ok         the check ran and found nothing
#   AGAINST    something counts against leaving, and is named
#   listed     something is there that belongs to other work; named,
#              and not counted
#   UNCHECKED  the check could not be made, with the reason; this
#              counts against leaving too
#
# The exit status is 0 when nothing counts against leaving, 1 when
# something does, and 2 when the command could not report at all.
#
# What belongs to the story is decided by branch name: a branch, a
# stash made on a branch, or a worktree on a branch whose name starts
# with a --story-branch prefix is the story's. That is the one
# attribution git can answer. Dates cannot do it: a stash records when
# it was made, and nothing records when a story began. Two things count
# whatever their branch: a worktree with uncommitted files, and commits
# on a detached HEAD that are on no branch.
#
# Stdlib-only (no gems). Run with --help for usage.

require 'open3'
require 'optparse'

module SafeToLeave
  Error = Class.new(StandardError)

  DEFAULT_REMOTE = 'origin'

  # Ruby tags git's output, the arguments, and the working directory
  # with the locale's encoding, and under the C locale text holding a
  # non-ASCII letter is then a string no pattern can be matched against
  # and no UTF-8 string joined to. Git and the file system hold names as
  # bytes, nearly always UTF-8; a byte that is not becomes U+FFFD.
  def self.utf8(text)
    text.dup.force_encoding(Encoding::UTF_8).scrub
  end

  USAGE = <<~TXT
    Usage: safe-to-leave [-C DIR] [--remote NAME] [--story-branch PREFIX]...

    Reports what is left behind in a repository, in one or more lines
    per check. Nothing is changed. Each line starts with one of:

      ok         the check ran and found nothing
      AGAINST    something counts against leaving, and is named
      listed     something belongs to other work; named, and not counted
      UNCHECKED  the check could not be made; counts against leaving too

      -C DIR          the repository to report on (default: the working
                      directory)
      --remote NAME   the remote unpushed commits are measured against
                      (default: #{DEFAULT_REMOTE})
      --story-branch PREFIX
                      a branch-name prefix that marks the finished story's
                      branches, such as "abc-123-". Repeat it for a story
                      with more than one. Unpushed commits on such a
                      branch, a stash made on one, and a worktree on one
                      count against leaving. Unpushed commits and stashes
                      on any other branch are listed, and so is a clean
                      worktree on one. With no prefix given, nothing can
                      be attributed, and every branch is treated as the
                      story's
      -h, --help      print this message

    A worktree with uncommitted files counts whatever its branch, and so
    do commits on a detached HEAD that are on no branch.

    Unpushed commits are measured against what the remote had as of your
    last fetch, so fetch first. The remote itself is asked only which
    branch is its default. When it cannot be reached, the unpushed check
    is UNCHECKED and the others still run.

    Exit status: 0 nothing counts against leaving, 1 something does (an
    UNCHECKED line included), 2 the report could not be made.
  TXT

  OK = 'ok'
  AGAINST = 'AGAINST'
  LISTED = 'listed'
  UNCHECKED = 'UNCHECKED'

  # One line of the report. More than one can carry the same check
  # name: the stashes that count and the stashes that are only listed
  # are separate lines, so that a reader scanning for AGAINST finds
  # exactly the things that are.
  Line = Struct.new(:check, :status, :detail) do
    def against?
      [AGAINST, UNCHECKED].include?(status)
    end
  end

  Stash = Struct.new(:ref, :subject) do
    # One line of `git stash list --format=%gd%x00%gs`. A line with no
    # separator is not a stash entry, and is kept with an empty subject:
    # it names no branch, and a stash that names no branch counts.
    def self.parse(line)
      ref, subject = line.split("\0", 2)
      new(ref, subject.to_s)
    end
  end

  # What the remote said when asked: the name of its default branch,
  # and the commit each of its branches is at, by branch name.
  Advertised = Struct.new(:default, :heads)

  # `changes` is the number of uncommitted or untracked entries, and
  # `detached_commits` the number of commits on a detached HEAD that are
  # on no branch. Both are nil when the worktree could not be read, and
  # `reason` then says why.
  Worktree = Struct.new(:path, :branch, :changes, :detached_commits, :reason)

  # What each check concludes, as functions of gathered facts. Nothing
  # here runs a command.
  module Checks
    # The two subjects git writes for a stash: "WIP on <branch>: ..."
    # for a bare `git stash`, "On <branch>: ..." for `stash push -m`. A
    # refname cannot contain a colon, so the first one ends the name.
    # With HEAD detached git writes "(no branch)" there, which names
    # nothing.
    STASH_BRANCH = /\A(?:WIP on|On) ([^:]+): /
    NO_BRANCH = '(no branch)'

    module_function

    def working_tree(entries)
      return [Line.new('working-tree', OK, 'clean')] if entries.empty?

      [Line.new('working-tree', AGAINST,
                "#{count(entries.length, 'uncommitted or untracked file')}: #{entries.join(', ')}")]
    end

    # A stash that names no branch counts: it may be the story's, and
    # nothing says otherwise.
    def stashes(stashes, prefixes)
      return [Line.new('stashes', OK, 'none')] if stashes.empty?

      counted, others = stashes.partition do |stash|
        branch = stash_branch(stash.subject)
        branch.nil? || story_branch?(branch, prefixes)
      end
      describe = ->(list) { list.map { |stash| "#{stash.ref} (#{stash.subject})" }.join(', ') }
      [
        (Line.new('stashes', AGAINST, describe.call(counted)) unless counted.empty?),
        (Line.new('stashes', LISTED, "not counted, from other work: #{describe.call(others)}") unless others.empty?)
      ].compact
    end

    def stash_branch(subject)
      name = subject[STASH_BRANCH, 1]
      name == NO_BRANCH ? nil : name
    end

    # With no prefix given no branch can be told from the story's, and
    # every branch is treated as the story's.
    def story_branch?(name, prefixes)
      prefixes.empty? || prefixes.any? { |prefix| name.start_with?(prefix) }
    end

    # `branches` maps each local branch other than the default to the
    # number of its commits no branch on the remote has. `detached` is
    # the number of commits on a detached HEAD that are on no branch,
    # local or on the remote.
    def unpushed(default:, default_ahead:, detached:, branches:, prefixes:)
      ahead = branches.select { |_name, commits| commits.positive? }
      story, others = ahead.partition { |name, _commits| story_branch?(name, prefixes) }
      counted = story.map { |name, commits| "#{name} (#{count(commits, 'commit')})" }
      counted.unshift("HEAD is detached with #{count_on_no_branch(detached)}") if detached.positive?
      counted.unshift("#{default} is #{count(default_ahead, 'commit')} ahead of the remote") if default_ahead.positive?
      lines = []
      lines << Line.new('unpushed', AGAINST, counted.join(', ')) unless counted.empty?
      unless others.empty?
        named = others.map { |name, commits| "#{name} (#{count(commits, 'commit')})" }
        lines << Line.new('unpushed', LISTED, "not counted, on other branches: #{named.join(', ')}")
      end
      lines.empty? ? [Line.new('unpushed', OK, 'no local commit is missing from the remote')] : lines
    end

    # `worktrees` holds every worktree other than the one reported on.
    def worktrees(worktrees, prefixes)
      return [Line.new('worktrees', OK, 'no other worktree')] if worktrees.empty?

      unread, read = worktrees.partition { |worktree| worktree.changes.nil? }
      counted, clean = read.partition do |worktree|
        worktree.changes.positive? || worktree.detached_commits.positive? ||
          (worktree.branch && story_branch?(worktree.branch, prefixes))
      end
      [
        (Line.new('worktrees', UNCHECKED, "could not be read: #{describe_unread(unread)}") unless unread.empty?),
        (Line.new('worktrees', AGAINST, describe_worktrees(counted)) unless counted.empty?),
        (Line.new('worktrees', LISTED, "not counted, clean and on other work: #{clean.map(&:path).join(', ')}") unless clean.empty?)
      ].compact
    end

    def describe_unread(worktrees)
      worktrees.map { |worktree| "#{worktree.path} (#{worktree.reason})" }.join(', ')
    end

    def describe_worktrees(worktrees)
      worktrees.map do |worktree|
        facts = [
          worktree.branch ? "on #{worktree.branch}" : 'detached',
          (count_on_no_branch(worktree.detached_commits) if worktree.detached_commits.positive?),
          (count(worktree.changes, 'uncommitted or untracked file') if worktree.changes.positive?)
        ]
        "#{worktree.path} (#{facts.compact.join(', ')})"
      end.join(', ')
    end

    def count_on_no_branch(commits)
      "#{count(commits, 'commit')} on no branch"
    end

    def count(number, noun)
      "#{number} #{noun}#{'s' unless number == 1}"
    end
  end

  # The only code that shells out.
  class Git
    # Git environment variables that name a repository. `git -C DIR`
    # does not override an inherited GIT_DIR, so a report run with one
    # set describes a repository the caller never named.
    LOCATION_ENV_KEYS = %w[
      GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE
    ].freeze

    # The environment of every child. A nil value unsets the variable.
    # The prompt settings keep `ls-remote` from waiting on a terminal
    # for credentials. GIT_OPTIONAL_LOCKS stops `git status` from
    # rewriting the index it reads, here and in every other worktree.
    # LC_ALL keeps git's messages, which are quoted in UNCHECKED lines,
    # in one language.
    CHILD_ENV = LOCATION_ENV_KEYS.to_h { |key| [key, nil] }.merge(
      'GIT_TERMINAL_PROMPT' => '0', 'GIT_ASKPASS' => nil, 'SSH_ASKPASS' => nil,
      'GIT_OPTIONAL_LOCKS' => '0', 'LC_ALL' => 'C'
    ).freeze

    # A porcelain status entry that carries a second path: the entry is
    # followed by the path it was renamed or copied from.
    TWO_PATH_STATUS = /\A.?[RC]/

    def initialize(dir:, remote:)
      @dir = dir
      @remote = remote
    end

    def toplevel
      stdout, stderr, status = capture('rev-parse', '--show-toplevel')
      raise Error, "cannot report on #{@dir}: #{complaint(stderr)}" unless status.success?

      stdout.chomp
    end

    # Refuses a directory that is not the top of a worktree. A worktree
    # directory that has lost its .git file is a plain directory, and
    # git run inside it answers for whatever repository encloses it.
    def require_worktree_root
      raise Error, 'its directory is missing' unless File.directory?(@dir)

      found = toplevel
      raise Error, "git finds #{found} there" unless File.realpath(found) == File.realpath(@dir)
    end

    # -z, so a path with a space or a non-ASCII letter arrives as
    # itself, where the default form quotes and escapes it. The two
    # settings are passed because configuration can turn either off:
    # status.showUntrackedFiles hides untracked files, and
    # diff.ignoreSubmodules hides a changed submodule.
    def status_entries
      tokens = output('status', '--porcelain=v1', '-z', '--untracked-files=normal',
                      '--ignore-submodules=none').split("\0")
      entries = []
      until tokens.empty?
        token = tokens.shift
        tokens.shift if token.match?(TWO_PATH_STATUS)
        entries << token[3..]
      end
      entries
    end

    # Asked of the remote. refs/remotes/<remote>/HEAD is a local record
    # written at clone time, and names the old branch after a default
    # branch is renamed.
    def default_branch
      advertised.default
    end

    # The remote-tracking refs that are where the remote's branches are
    # now. A tracking ref records the last fetch. One whose branch the
    # remote has since deleted or moved names commits the remote may not
    # have, and is left out, so those commits count as unpushed.
    def current_tracking_refs
      @current_tracking_refs ||= begin
        prefix = "refs/remotes/#{@remote}/"
        output('for-each-ref', '--format=%(objectname) %(refname)', prefix).lines(chomp: true).filter_map do |line|
          commit, ref = line.split(' ', 2)
          ref if advertised.heads[ref.delete_prefix(prefix)] == commit
        end
      end
    end

    # Short names, for the report. A tag sharing a branch's name makes
    # the short form ambiguous to rev-list, so the two methods below
    # hand git the full refname.
    def local_branches
      output('for-each-ref', '--format=%(refname)', 'refs/heads/')
        .lines(chomp: true).map { |ref| ref.delete_prefix('refs/heads/') }
    end

    def default_ahead(default)
      tracking = "refs/remotes/#{@remote}/#{default}"
      raise Error, "#{tracking} is absent; fetch #{@remote} first" unless ref?(tracking)
      unless current_tracking_refs.include?(tracking)
        raise Error, "#{tracking} is not where #{@remote} has #{default} now; fetch #{@remote} first"
      end
      return 0 unless ref?("refs/heads/#{default}")

      commits_beyond("refs/heads/#{default}", [tracking])
    end

    def unpushed_on(branch)
      commits_beyond("refs/heads/#{branch}", current_tracking_refs)
    end

    # The commits on a detached HEAD that no local branch and no branch
    # on the remote has, and 0 when HEAD is on a branch. Worktrees share
    # their refs, so a linked worktree's reader is handed the reader
    # that has already asked the remote.
    def detached_commits(asked = self)
      return 0 unless detached?

      commits_beyond('HEAD', local_branches.map { |branch| "refs/heads/#{branch}" } + asked.current_tracking_refs)
    end

    def stashes
      output('stash', 'list', '--format=%gd%x00%gs').lines(chomp: true).map { |line| Stash.parse(line) }
    end

    # Every worktree but the one at `here`, each with its branch, how
    # many entries its own status shows, and its detached commits.
    def other_worktrees(here)
      worktree_records.reject { |record| same_directory?(record[:path], here) }
                      .map { |record| read_worktree(record[:path], record[:branch]) }
    end

    private

    def capture(*args, stdin: '')
      stdout, stderr, status = Open3.capture3(CHILD_ENV, 'git', '-C', @dir, *args, stdin_data: stdin)
      [SafeToLeave.utf8(stdout), SafeToLeave.utf8(stderr), status]
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "could not run git: #{e.message}"
    end

    def output(*args, stdin: '')
      stdout, stderr, status = capture(*args, stdin: stdin)
      raise Error, "git #{args.first} failed: #{complaint(stderr)}" unless status.success?

      stdout
    end

    # The first line of what git wrote. The rest repeats it or is
    # advice, and a report line is one line.
    def complaint(stderr)
      stderr.lines.first.to_s.strip
    end

    # git takes a URL or a path where a remote's name is expected, and
    # would contact whatever it was handed. A name that is not
    # configured is a misspelling.
    def require_configured_remote
      configured = output('remote').lines(chomp: true)
      return if configured.include?(@remote)

      known = configured.empty? ? 'this repository has none' : "configured: #{configured.join(', ')}"
      raise Error, "no such remote: #{@remote} (#{known})"
    end

    # One question to the remote: which branch is its default, and
    # where each of its branches is.
    def advertised
      @advertised ||= begin
        require_configured_remote
        answer = output('ls-remote', '--symref', @remote, 'HEAD', 'refs/heads/*')
                 .lines(chomp: true).map { |line| line.split("\t", 2) }
        default = answer.find { |value, ref| ref == 'HEAD' && value.start_with?('ref: refs/heads/') }
        raise Error, "#{@remote} names no default branch" if default.nil?

        heads = answer.select { |_commit, ref| ref.to_s.start_with?('refs/heads/') }
                      .to_h { |commit, ref| [ref.delete_prefix('refs/heads/'), commit] }
        Advertised.new(default.first.delete_prefix('ref: refs/heads/'), heads)
      end
    end

    def ref?(name)
      capture('show-ref', '--verify', '--quiet', name).last.success?
    end

    # The number of commits reachable from `tip` and from none of
    # `refs`. The refs go in on stdin, since a remote can have more
    # branches than a command line holds.
    def commits_beyond(tip, refs)
      revisions = [tip] + refs.map { |ref| "^#{ref}" }
      Integer(output('rev-list', '--count', '--stdin', stdin: revisions.join("\n")).strip)
    end

    # `symbolic-ref -q` exits 1 for a detached HEAD and higher for a
    # failure.
    def detached?
      _stdout, stderr, status = capture('symbolic-ref', '-q', 'HEAD')
      return false if status.success?
      raise Error, "git symbolic-ref failed: #{complaint(stderr)}" unless status.exitstatus == 1

      true
    end

    # -z, so a path holding a newline stays one field: fields end with
    # NUL and records with a second one.
    def worktree_records
      output('worktree', 'list', '--porcelain', '-z').split("\0\0").filter_map do |record|
        fields = record.split("\0")
        path = fields.find { |field| field.start_with?('worktree ') }&.delete_prefix('worktree ')
        next if path.nil? || fields.include?('bare')

        branch = fields.find { |field| field.start_with?('branch ') }
        { path: path, branch: branch&.delete_prefix('branch refs/heads/') }
      end
    end

    def same_directory?(path, other)
      File.exist?(path) && File.exist?(other) && File.realpath(path) == File.realpath(other)
    end

    def read_worktree(path, branch)
      there = Git.new(dir: path, remote: @remote)
      there.require_worktree_root
      Worktree.new(path, branch, there.status_entries.length, there.detached_commits(self))
    rescue Error => e
      Worktree.new(path, branch, nil, nil, e.message)
    end
  end

  # Gathers the facts for each check and hands them to Checks.
  # A check whose facts cannot be gathered becomes an UNCHECKED line
  # carrying the reason, and the checks after it still run.
  class Report
    def initialize(git:, here:, prefixes:)
      @git = git
      @here = here
      @prefixes = prefixes
    end

    def lines
      [
        checked('working-tree') { Checks.working_tree(@git.status_entries) },
        checked('unpushed') { unpushed },
        checked('stashes') { Checks.stashes(@git.stashes, @prefixes) },
        checked('worktrees') { Checks.worktrees(@git.other_worktrees(@here), @prefixes) }
      ].flatten
    end

    private

    def checked(check)
      yield
    rescue Error => e
      [Line.new(check, UNCHECKED, e.message)]
    end

    def unpushed
      default = @git.default_branch
      branches = (@git.local_branches - [default]).to_h { |branch| [branch, @git.unpushed_on(branch)] }
      Checks.unpushed(default: default, default_ahead: @git.default_ahead(default),
                      detached: @git.detached_commits, branches: branches, prefixes: @prefixes)
    end
  end

  class CLI
    # A value-taking flag swallows a following flag as its value, so
    # each one refuses a value with a leading dash.
    VALUE_NOT_FLAG = /\A[^-].*\z/m

    # Control characters, and the Unicode characters that reorder the
    # text around them.
    UNPRINTABLE = /[[:cntrl:]‪-‮⁦-⁩]/

    def self.run(argv)
      new.run(argv)
    end

    def run(argv)
      options = parse(argv.map { |argument| SafeToLeave.utf8(argument) })
      return puts(USAGE) if options[:help]

      git = Git.new(dir: options[:dir], remote: options[:remote])
      here = git.toplevel
      lines = Report.new(git: git, here: here, prefixes: options[:prefixes]).lines
      print_report(here, lines)
      exit 1 if lines.any?(&:against?)
    rescue Error => e
      refuse(e.message)
    # Ruby exits 1 on an exception nothing rescued, and 1 is this
    # command's answer that something counts against leaving.
    rescue StandardError => e
      refuse("unexpected #{e.class}: #{e.message}")
    end

    private

    # A request for usage is answered even beside a stray argument.
    def parse(argv)
      refuse_completion_flags(argv)
      options = { prefixes: [], help: false }
      stray = option_parser(options).permute(argv)
      unless stray.empty? || options[:help]
        raise Error, "unexpected extra arguments: #{stray.map(&:inspect).join(', ')}"
      end

      { dir: SafeToLeave.utf8(Dir.pwd), remote: DEFAULT_REMOTE }.merge(options)
    rescue OptionParser::ParseError => e
      raise Error, e.message
    end

    # OptionParser answers `--*-completion-bash` and
    # `--*-completion-zsh` itself, by printing and exiting 0, and offers
    # no way to turn them off.
    def refuse_completion_flags(argv)
      flag = argv.find { |argument| argument.start_with?('--*') }
      raise Error, "invalid option: #{flag}" if flag
    end

    # The caller runs permute rather than parse, which stops at the
    # first positional when POSIXLY_CORRECT is set.
    def option_parser(options)
      OptionParser.new do |o|
        # Abbreviation is off: `--rem` is a typo, and no flag.
        o.require_exact = true
        o.on('-C DIR', VALUE_NOT_FLAG) { |dir| set_once(options, :dir, '-C', dir) }
        o.on('--remote NAME', VALUE_NOT_FLAG) { |name| set_once(options, :remote, '--remote', name) }
        o.on('--story-branch PREFIX', VALUE_NOT_FLAG) { |prefix| options[:prefixes] << prefix }
        o.on('-h', '--help') { options[:help] = true }
        # OptionParser answers --version itself, by exiting 1. The
        # plugin this ships in has no version to give.
        o.on('--version') { raise Error, 'invalid option: --version' }
      end
    end

    # Taking the last of a repeated -C or --remote would report on one
    # of two things the caller named.
    def set_once(options, key, flag, value)
      raise Error, "duplicate #{flag}" if options.key?(key)

      options[key] = value
    end

    def print_report(toplevel, lines)
      puts "safe-to-leave: #{printable(toplevel)}"
      lines.each do |line|
        puts format('  %-10<status>s%<check>s: %<detail>s', status: line.status, check: line.check,
                                                           detail: printable(line.detail))
      end
      against = lines.count(&:against?)
      if against.zero?
        puts 'safe-to-leave: nothing counts against leaving (repository checks)'
      else
        puts "safe-to-leave: #{against} #{against == 1 ? 'line counts' : 'lines count'} against leaving"
      end
    end

    # File names, stash subjects, worktree paths, and git's messages can
    # hold a newline or a terminal escape, and they are printed inside
    # lines that a reader, or a session, takes as this command's own.
    # Each such character is printed as its Ruby escape.
    def printable(text)
      SafeToLeave.utf8(text).gsub(UNPRINTABLE) { |character| character.dump[1..-2] }
    end

    def refuse(message)
      warn "safe-to-leave: #{printable(message)}"
      exit 2
    end
  end
end

SafeToLeave::CLI.run(ARGV) if $PROGRAM_NAME == __FILE__
