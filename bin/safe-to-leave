#!/usr/bin/env ruby
# frozen_string_literal: true

# safe-to-leave -- report what a finished story has left behind in a
# repository, so the developer can see it before closing the session.
#
# It prints one or more lines per check and changes nothing: it reads
# the working tree, whether a rebase, merge, cherry-pick, revert, or
# bisect was left unfinished there, the commits the remote does not
# have, the stashes, the linked worktrees, and, through the GitHub CLI,
# the open pull requests and issues that belong to the story and the
# workflow runs since it merged. The remote is asked, in one request,
# which branch is its default and where each of its branches is. That
# request and the GitHub CLI's are the only uses of the network. Each
# line of a check carries one of four words:
#
#   ok         the check ran and found nothing
#   AGAINST    something counts against leaving, and is named
#   listed     something is there that belongs to other work; named,
#              and not counted
#   UNCHECKED  the check could not be made, with the reason; this
#              counts against leaving too
#
# The exit status is 0 when nothing counts against leaving, 1 when
# something does, and 2 when the command could not report at all.
#
# What belongs to the story is decided by branch name: a branch, a
# stash made on a branch, or a worktree on a branch whose name starts
# with a --story-branch prefix is the story's. That is the one
# attribution git can answer. Dates cannot do it: a stash records when
# it was made, and nothing records when a story began. These count
# whatever the prefix: uncommitted files in the working tree or in any
# other worktree, commits on the default branch that the remote does not
# have, a stash that names no branch, commits on a detached HEAD that
# are on no branch, and every UNCHECKED line.
#
# The worktrees check needs git 2.36 or newer, for `worktree list -z`.
#
# Stdlib-only (no gems). Run with --help for usage.

require 'json'
require 'open3'
require 'optparse'

module SafeToLeave
  Error = Class.new(StandardError)

  DEFAULT_REMOTE = 'origin'
  DEFAULT_REMOTE_TIMEOUT = 30

  USAGE = <<~TXT
    Usage: safe-to-leave [-C DIR] [--remote NAME] [--remote-timeout SECONDS]
                         [--story-branch PREFIX]... [--issue NUMBER]
                         [--plan FILE] [--merge-commit SHA] [--repo OWNER/NAME]

    Reports what a finished story has left behind in a repository and on
    GitHub, in one or more lines per check. Nothing is changed. Each line
    of a check starts with one of:

      ok         the check ran and found nothing
      AGAINST    something counts against leaving, and is named
      listed     something belongs to other work; named, and not counted
      UNCHECKED  the check could not be made; counts against leaving too

      -C DIR          the repository to report on (default: the working
                      directory)
      --remote NAME   the remote unpushed commits are measured against
                      (default: #{DEFAULT_REMOTE})
      --remote-timeout SECONDS
                      how long the remote, and each call to gh, is given
                      to answer (default: #{DEFAULT_REMOTE_TIMEOUT})
      --story-branch PREFIX
                      a branch-name prefix that marks the finished story's
                      branches, such as "abc-123-". Repeat it for a story
                      with more than one. Unpushed commits on such a
                      branch, a stash made on one, and a worktree on one
                      count against leaving. Unpushed commits and stashes
                      on any other branch are listed, and so is a clean
                      worktree on one. With no prefix given, nothing can
                      be attributed, and every branch is treated as the
                      story's. An open pull request counts when its branch
                      carries a prefix, and for a prefix shaped like
                      "abc-123-" also when its title starts with ABC-123.
                      With no prefix given, a pull request counts only by
                      closing the --issue
      --issue NUMBER  the story's GitHub issue. It counts if it is still
                      open, and so does an open pull request that closes
                      it, or another open issue whose title or body names
                      it, by number or by a key such as ABC-123 taken
                      from a prefix. Without it no issues are looked for
      --plan FILE     the story's plan file. An open issue whose number it
                      mentions is one already known about: listed, not
                      counted
      --merge-commit SHA
                      the commit that landed the story. The workflow runs
                      created since it are read. A run a push triggered
                      on the default branch, on a commit containing the
                      merge, counts if any attempt of it did not pass, and
                      is UNCHECKED while it is still going or while its
                      commit is one this clone has not fetched. A failed
                      run anywhere else, a pull request's among them, is
                      listed for you to judge. Without it no runs are
                      looked for
      --repo [HOST/]OWNER/NAME
                      the GitHub repository to ask (default: whichever one
                      gh resolves from DIR). Name it in a clone of a fork,
                      where pull requests live in the repository they
                      were opened against
      -h, --help      print this message

    These count whatever the prefix: uncommitted files in the working
    tree or in any other worktree, a rebase, merge, cherry-pick, revert,
    or bisect left unfinished in the working tree, commits on the
    default branch that
    the remote does not have, a stash that names no branch, commits on a
    detached HEAD that are on no branch, and every UNCHECKED line.

    Unpushed commits are measured against your remote-tracking branches,
    so fetch first. The remote is asked which branch is its default and
    where each of its branches is. A tracking branch the remote has
    since moved or deleted is not measured against, and its commits
    count as unpushed. When that branch is the default one, the unpushed
    check is UNCHECKED until you fetch. When the remote cannot be
    reached or does not answer in time, the unpushed check is UNCHECKED, and so are the commits of
    a worktree with a detached HEAD. Everything else is still reported.

    The worktrees check needs git 2.36 or newer.

    The pull request, issue, and workflow-run lines are asked of gh.
    Each is UNCHECKED when gh is missing, is not signed in, or does not
    answer. The last line of the report names any of them that was not
    looked for.

    Exit status: 0 nothing counts against leaving, 1 something does (an
    UNCHECKED line included), 2 the report could not be made.
  TXT

  OK = 'ok'
  AGAINST = 'AGAINST'
  LISTED = 'listed'
  UNCHECKED = 'UNCHECKED'

  # One line of the report. More than one can carry the same check
  # name: the stashes that count and the stashes that are only listed
  # are separate lines, so that a reader scanning for AGAINST finds
  # exactly the things that are.
  Line = Struct.new(:check, :status, :detail) do
    def against?
      [AGAINST, UNCHECKED].include?(status)
    end
  end

  Stash = Struct.new(:ref, :subject) do
    # One line of `git stash list --format=%gd%x00%gs`. A line with no
    # separator is not a stash entry, and is kept with an empty subject:
    # it names no branch, and a stash that names no branch counts.
    def self.parse(line)
      ref, subject = line.split("\0", 2)
      new(ref, subject.to_s)
    end
  end

  # One workflow run. `conclusions` holds one entry per attempt read,
  # oldest first, nil for an attempt that has not finished.
  # `holds_merge` is true when the run's commit contains the merge
  # commit, false when it does not, and nil when this clone does not
  # have the run's commit to ask about, or nobody asked.
  Run = Struct.new(:id, :workflow, :branch, :event, :status, :conclusions, :holds_merge, keyword_init: true)

  # What the remote said when asked: the name of its default branch,
  # and the commit each of its branches is at, by branch name.
  Advertised = Struct.new(:default, :heads)

  # `changes` is the number of uncommitted or untracked entries, and
  # `detached_commits` the number of commits on a HEAD that is on no
  # branch which no branch has. Both are nil when the worktree could not
  # be read, and `detached_commits` alone when its files were read and
  # its commits could not be measured. `reason` then says why.
  Worktree = Struct.new(:path, :branch, :changes, :detached_commits, :reason) do
    def self.read(path, branch, changes:, detached_commits:)
      new(path, branch, changes, detached_commits, nil)
    end

    def self.unmeasured(path, branch, changes, reason)
      new(path, branch, changes, nil, reason)
    end

    def self.unread(path, branch, reason)
      new(path, branch, nil, nil, reason)
    end
  end

  # Ruby tags git's output, the arguments, and the working directory
  # with the locale's encoding, and under the C locale text holding a
  # non-ASCII letter is then a string no pattern can be matched against
  # and no UTF-8 string joined to. Git and the file system hold names as
  # bytes, nearly always UTF-8; a byte that is not becomes U+FFFD.
  def self.utf8(text)
    text.dup.force_encoding(Encoding::UTF_8).scrub
  end

  # What a command wrote and how it ended, as [stdout, stderr, status],
  # or nil when `seconds` passed first. A command that takes a
  # connection and never gets an answer would otherwise hold the
  # report, and the session running it, for as long as it liked. The
  # limit is on the command ending and on its output being read to the
  # end, since something it started can hold that output open after it
  # ends. The command runs in a process group of its own so that
  # whatever it started is stopped with it.
  def self.capture_within(seconds, env, command, **options)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + seconds
    Open3.popen3(env, *command, pgroup: true, **options) do |stdin, stdout, stderr, child|
      stdin.close
      readers = [stdout, stderr].map { |stream| Thread.new { stream.read } }
      waited_for = [child, *readers].all? do |thread|
        thread.join([deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC), 0].max)
      end
      next [utf8(readers.first.value), utf8(readers.last.value), child.value] if waited_for

      stop(child.pid, readers)
      nil
    end
  end

  # The readers are stopped before popen3 closes the streams they are
  # reading, which would otherwise end each with an error Ruby prints.
  # By now the group may already be gone.
  def self.stop(group, readers)
    Process.kill('KILL', -group)
  rescue Errno::ESRCH, Errno::EPERM
    nil
  ensure
    readers.each(&:kill).each(&:join)
  end

  # What each check concludes, as functions of gathered facts. Nothing
  # here runs a command.
  module Checks
    # The two subjects git writes for a stash: "WIP on <branch>: ..."
    # for a bare `git stash`, "On <branch>: ..." for `stash push -m`. A
    # refname cannot contain a colon, so the first one ends the name.
    # With HEAD detached git writes "(no branch)" there, which names
    # nothing.
    STASH_BRANCH = /\A(?:WIP on|On) ([^:]+): /
    NO_BRANCH = '(no branch)'

    # A prefix shaped like abc-123- names an issue key, ABC-123, that a
    # title or an issue body can be matched on. A bare number prefix
    # (123-) names nothing a sentence could not also contain by chance.
    KEYED_PREFIX = /\A([a-z][a-z0-9]*-\d+)-\z/i

    # The conclusions of an attempt that passed, or that reported no
    # result. Any other conclusion of a finished attempt counts, one
    # GitHub adds later included.
    PASSING_CONCLUSIONS = %w[success skipped neutral].freeze

    # How the detail starts when no run that could count was found. In
    # the seconds after a merge GitHub has not created the run yet.
    NO_RUN_FOUND = 'no run found since the merge'

    PUSH = 'push'
    COMPLETED = 'completed'

    # How much of a title or a name is printed.
    QUOTE_LIMIT = 80

    module_function

    def working_tree(entries)
      return [Line.new('working-tree', OK, 'clean')] if entries.empty?

      [Line.new('working-tree', AGAINST,
                "#{count(entries.length, 'uncommitted or untracked file')}: #{entries.join(', ')}")]
    end

    # `operations` names what was started and not finished in the
    # working tree: "a rebase", "a merge".
    def in_progress(operations)
      return [Line.new('in-progress', OK, 'none')] if operations.empty?

      [Line.new('in-progress', AGAINST, operations.join(', '))]
    end

    # A stash that names no branch counts: it may be the story's, and
    # nothing says otherwise.
    def stashes(stashes, prefixes)
      return [Line.new('stashes', OK, 'none')] if stashes.empty?

      counted, others = stashes.partition do |stash|
        branch = stash_branch(stash.subject)
        branch.nil? || story_branch?(branch, prefixes)
      end
      describe = ->(list) { list.map { |stash| "#{stash.ref} (#{stash.subject})" }.join(', ') }
      [
        (Line.new('stashes', AGAINST, describe.call(counted)) unless counted.empty?),
        (Line.new('stashes', LISTED, "not counted, from other work: #{describe.call(others)}") unless others.empty?)
      ].compact
    end

    def stash_branch(subject)
      name = subject[STASH_BRANCH, 1]
      name == NO_BRANCH ? nil : name
    end

    # With no prefix given no branch can be told from the story's, and
    # every branch is treated as the story's.
    def story_branch?(name, prefixes)
      prefixes.empty? || prefixes.any? { |prefix| name.start_with?(prefix) }
    end

    # `branches` maps each local branch other than the default to the
    # number of its commits no branch on the remote has. `detached` is
    # the number of commits on a detached HEAD that are on no branch,
    # local or on the remote.
    def unpushed(default:, default_ahead:, detached:, branches:, prefixes:)
      ahead = branches.select { |_name, commits| commits.positive? }
      story, others = ahead.partition { |name, _commits| story_branch?(name, prefixes) }
      counted = story.map { |name, commits| "#{name} (#{count(commits, 'commit')})" }
      counted.unshift("HEAD is detached with #{count_on_no_branch(detached)}") if detached.positive?
      counted.unshift("#{default} is #{count(default_ahead, 'commit')} ahead of the remote") if default_ahead.positive?
      lines = []
      lines << Line.new('unpushed', AGAINST, counted.join(', ')) unless counted.empty?
      unless others.empty?
        named = others.map { |name, commits| "#{name} (#{count(commits, 'commit')})" }
        lines << Line.new('unpushed', LISTED, "not counted, on other branches: #{named.join(', ')}")
      end
      lines.empty? ? [Line.new('unpushed', OK, 'no local commit is missing from the remote')] : lines
    end

    # `worktrees` holds every worktree other than the one reported on.
    def worktrees(worktrees, prefixes)
      return [Line.new('worktrees', OK, 'no other worktree')] if worktrees.empty?

      unread, read = worktrees.partition { |worktree| worktree.changes.nil? }
      unmeasured = read.select { |worktree| worktree.detached_commits.nil? }
      counted, clean = (read - unmeasured).partition do |worktree|
        worktree.changes.positive? || worktree.detached_commits.positive? ||
          (worktree.branch && story_branch?(worktree.branch, prefixes))
      end
      counted += unmeasured.select { |worktree| worktree.changes.positive? }
      [
        (Line.new('worktrees', UNCHECKED, "could not be read: #{describe_unread(unread)}") unless unread.empty?),
        unless unmeasured.empty?
          Line.new('worktrees', UNCHECKED, "commits on a detached HEAD not measured: #{describe_unread(unmeasured)}")
        end,
        (Line.new('worktrees', AGAINST, describe_worktrees(counted)) unless counted.empty?),
        (Line.new('worktrees', LISTED, "not counted, clean and on other work: #{paths(clean)}") unless clean.empty?)
      ].compact
    end

    def paths(worktrees)
      worktrees.map(&:path).join(', ')
    end

    def describe_unread(worktrees)
      worktrees.map { |worktree| "#{worktree.path} (#{worktree.reason})" }.join(', ')
    end

    def describe_worktrees(worktrees)
      worktrees.map do |worktree|
        facts = [
          worktree.branch ? "on #{worktree.branch}" : 'detached',
          (count_on_no_branch(worktree.detached_commits) if worktree.detached_commits.to_i.positive?),
          (count(worktree.changes, 'uncommitted or untracked file') if worktree.changes.positive?)
        ]
        "#{worktree.path} (#{facts.compact.join(', ')})"
      end.join(', ')
    end

    def count_on_no_branch(commits)
      "#{count(commits, 'commit')} on no branch"
    end

    # A pull request is the story's when its branch carries a prefix,
    # when it closes the story's issue, or when its title starts with
    # the story's key. With no prefix given nothing is treated as the
    # story's by its branch: that rule is for one machine's branches,
    # and here it would count every open pull request there is.
    def pull_requests(pull_requests, prefixes:, issue:)
      keys = story_keys(prefixes)
      counted = pull_requests.select do |pull_request|
        prefixes.any? { |prefix| pull_request['headRefName'].to_s.start_with?(prefix) } ||
          closes?(pull_request, issue) ||
          keys.any? { |key| pull_request['title'].to_s.match?(/\A#{Regexp.escape(key)}(?!\d)/i) }
      end
      return [Line.new('pull-requests', OK, 'none open for this story')] if counted.empty?

      [Line.new('pull-requests', AGAINST, "open: #{counted.map { |record| titled(record) }.join(', ')}")]
    end

    def closes?(pull_request, issue)
      return false if issue.nil?

      Array(pull_request['closingIssuesReferences']).any? { |reference| reference['number'] == issue }
    end

    def story_keys(prefixes)
      prefixes.filter_map { |prefix| prefix[KEYED_PREFIX, 1] }
    end

    # `plan_numbers` holds the issue numbers the story's plan mentions.
    def issues(open_issues, issue:, prefixes:, plan_numbers:)
      return [Line.new('issues', LISTED, 'not looked for: no --issue given')] if issue.nil?

      own, others = open_issues.partition { |record| record['number'] == issue }
      keys = story_keys(prefixes)
      naming = others.select do |record|
        text = "#{record['title']}\n#{record['body']}"
        names_issue?(text, issue) || names_key?(text, keys)
      end
      known, unknown = naming.partition { |record| plan_numbers.include?(record['number']) }
      counted = own.map { |record| "#{titled(record)} is still open" } +
                unknown.map { |record| "#{titled(record)} names this story" }
      lines = []
      lines << Line.new('issues', AGAINST, "open: #{counted.join(', ')}") unless counted.empty?
      unless known.empty?
        named = known.map { |record| titled(record) }.join(', ')
        lines << Line.new('issues', LISTED, "not counted, named in the plan: #{named}")
      end
      lines.empty? ? [Line.new('issues', OK, 'none open for this story')] : lines
    end

    # The lookbehind keeps out owner/repository#12, another
    # repository's issue of the same number, and (?!\d) keeps #12 from
    # matching #123.
    def names_issue?(text, issue)
      text.match?(%r{(?<![\w/#-])##{issue}(?!\d)})
    end

    # (?!\d), so that ABC-12 does not match ABC-123.
    def names_key?(text, keys)
      keys.any? { |key| text.match?(/(?<![\w-])#{Regexp.escape(key)}(?!\d)/i) }
    end

    # `on_default` holds the runs a push triggered on the default
    # branch since the merge, and is nil when no merge commit was named.
    # One of them on a commit containing the merge counts: there the
    # merged code is all that was tested. `elsewhere` holds the other
    # runs since the merge. A pull request's run, or a push to a branch
    # someone rebased, tests its own changes on top, so its failure is
    # listed, for a reader who knows what the story touched.
    # `cut_short` says the listing behind `elsewhere` filled its limit.
    def workflow_runs(on_default, elsewhere, default:, cut_short:)
      return [Line.new('workflow-runs', LISTED, 'not looked for: no --merge-commit given')] if on_default.nil?

      on_merge = on_default.select { |run| run.holds_merge == true }
      unplaced = on_default.select { |run| run.holds_merge.nil? }
      lines = counted_run_lines(on_merge, unplaced) + other_run_lines(elsewhere, cut_short)
      return lines unless on_merge.empty? && unplaced.empty?

      [Line.new('workflow-runs', LISTED, "#{NO_RUN_FOUND} on #{quoted(default)}")] + lines
    end

    def counted_run_lines(on_merge, unplaced)
      unfinished = on_merge.reject { |run| run.status == COMPLETED }
      failed = on_merge.select { |run| failed?(run) }
      lines = []
      unless unplaced.empty?
        lines << Line.new('workflow-runs', UNCHECKED,
                          "on commits this clone does not have, fetch and ask again: #{describe_runs(unplaced)}")
      end
      unless unfinished.empty?
        lines << Line.new('workflow-runs', UNCHECKED,
                          "still going, ask again when finished: #{describe_runs(unfinished)}")
      end
      lines << Line.new('workflow-runs', AGAINST, "failed: #{describe_runs(failed)}") unless failed.empty?
      return lines if on_merge.empty? || !lines.empty?

      [Line.new('workflow-runs', OK, "#{count(on_merge.length, 'run')} on commits containing the merge, none failed")]
    end

    def other_run_lines(elsewhere, cut_short)
      failed = elsewhere.select { |run| failed?(run) }
      lines = []
      unless failed.empty?
        lines << Line.new('workflow-runs', LISTED,
                          "not counted, failed elsewhere since the merge: #{describe_runs(failed)}")
      end
      if cut_short
        lines << Line.new('workflow-runs', LISTED,
                          'not counted, the listing of runs elsewhere was cut short at its limit')
      end
      lines
    end

    def failed?(run)
      !failed_attempts(run).empty?
    end

    def failed_attempts(run)
      run.conclusions.each_with_index.filter_map do |conclusion, index|
        next if conclusion.nil? || PASSING_CONCLUSIONS.include?(conclusion)

        "attempt #{index + 1} #{conclusion.to_s.tr('_', ' ')}"
      end
    end

    def describe_runs(runs)
      runs.map { |run| describe_run(run) }.join(', ')
    end

    def describe_run(run)
      workflow = run.workflow.to_s.empty? ? 'unnamed workflow' : quoted(run.workflow)
      where = run.branch.to_s.empty? ? 'no branch' : quoted(run.branch)
      where = "#{where}, #{run.event}" unless run.event == PUSH
      attempts = failed_attempts(run)
      "#{workflow} run #{run.id} on #{where}#{" (#{attempts.join(', ')})" unless attempts.empty?}"
    end

    # Every issue or pull request number the plan mentions. One the
    # plan names is one the developer already knows about, whatever
    # words surround it: a plan names its follow-ups in a sentence, not
    # in a fixed phrase.
    def plan_numbers(plan)
      plan.scan(%r{(?<![\w/#-])#(\d+)(?!\w)}).flatten.map(&:to_i).uniq
    end

    def titled(record)
      "##{record['number']} #{quoted(record['title'])}"
    end

    # A title, a workflow's name, or a branch's, as text someone outside
    # the project may have written: in quotes, with its own quotes
    # escaped, so that it cannot pass for the words around it, and cut
    # at QUOTE_LIMIT characters.
    def quoted(text)
      text = text.to_s
      kept = text[0, QUOTE_LIMIT].gsub(/["\\]/) { |character| "\\#{character}" }
      more = text.length - QUOTE_LIMIT
      "\"#{kept}\"#{" (+#{more} characters)" if more.positive?}"
    end

    def count(number, noun)
      "#{number} #{noun}#{'s' unless number == 1}"
    end
  end

  # Every git command the report runs.
  class Git
    # Git environment variables that name a repository. `git -C DIR`
    # does not override an inherited GIT_DIR, so a report run with one
    # set describes a repository the caller never named.
    LOCATION_ENV_KEYS = %w[
      GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE
    ].freeze

    # The environment of every child. A nil value unsets the variable.
    # The prompt settings keep `ls-remote` from waiting on a terminal
    # for credentials. GIT_OPTIONAL_LOCKS stops `git status` from
    # rewriting the index it reads, here and in every other worktree.
    # GIT_NO_REPLACE_OBJECTS has git read each commit as itself: a
    # replace ref can stand a local commit in for one the remote has,
    # and the commits behind it would then count as pushed. LC_ALL keeps
    # git's messages, which are quoted in UNCHECKED lines, in one
    # language.
    CHILD_ENV = LOCATION_ENV_KEYS.to_h { |key| [key, nil] }.merge(
      'GIT_TERMINAL_PROMPT' => '0', 'GIT_ASKPASS' => nil, 'SSH_ASKPASS' => nil,
      'GIT_OPTIONAL_LOCKS' => '0', 'GIT_NO_REPLACE_OBJECTS' => '1', 'LC_ALL' => 'C'
    ).freeze

    # The file or directory git keeps while each operation is under way,
    # by the name the report gives the operation.
    OPERATION_MARKERS = {
      'rebase-merge' => 'a rebase', 'rebase-apply' => 'a rebase', 'MERGE_HEAD' => 'a merge',
      'CHERRY_PICK_HEAD' => 'a cherry-pick', 'REVERT_HEAD' => 'a revert', 'BISECT_LOG' => 'a bisect'
    }.freeze

    # A porcelain status entry that carries a second path: the entry is
    # followed by the path it was renamed or copied from.
    TWO_PATH_STATUS = /\A.?[RC]/

    def initialize(dir:, remote:, remote_timeout:)
      @dir = dir
      @remote = remote
      @remote_timeout = remote_timeout
    end

    def toplevel
      stdout, stderr, status = capture('rev-parse', '--show-toplevel')
      raise Error, "cannot report on #{@dir}: #{complaint(stderr)}" unless status.success?

      # Not chomp, which would also take a carriage return that ends
      # the directory's name.
      stdout.delete_suffix("\n")
    end

    # Refuses a directory that is not the top of a worktree. A worktree
    # directory that has lost its .git file is a plain directory, and
    # git run inside it answers for whatever repository encloses it.
    def require_worktree_root
      raise Error, 'its directory is missing' unless File.directory?(@dir)

      found = toplevel
      raise Error, "git finds #{found} there" unless File.realpath(found) == File.realpath(@dir)
    end

    # -z, so a path with a space or a non-ASCII letter arrives as
    # itself, where the default form quotes and escapes it. The two
    # settings are passed because configuration can turn either off:
    # status.showUntrackedFiles hides untracked files, and
    # diff.ignoreSubmodules hides a changed submodule. Files status is
    # told to skip are compared with the index separately.
    def status_entries
      tokens = output('status', '--porcelain=v1', '-z', '--untracked-files=normal',
                      '--ignore-submodules=none').split("\0")
      entries = []
      until tokens.empty?
        token = tokens.shift
        tokens.shift if token.match?(TWO_PATH_STATUS)
        entries << token[3..]
      end
      entries + hidden_changes
    end

    # What was started in this working tree and not finished. A rebase
    # stopped partway or a bisect can leave the tree clean, so status
    # does not show it. `--git-path` answers with a path relative to the
    # directory git was run in.
    def operations_in_progress
      flags = OPERATION_MARKERS.keys.flat_map { |marker| ['--git-path', marker] }
      paths = output('rev-parse', *flags).lines(chomp: true)
      OPERATION_MARKERS.values.zip(paths).filter_map do |name, path|
        name if File.exist?(File.expand_path(path, @dir))
      end.uniq
    end

    # Asked of the remote. refs/remotes/<remote>/HEAD is a local record
    # written at clone time, and names the old branch after a default
    # branch is renamed.
    def default_branch
      advertised.default
    end

    # The full SHA of the commit `sha` abbreviates. A branch or a tag
    # can carry a name that is all hex digits, and git would read it
    # ahead of an abbreviated commit, so the answer has to start with
    # what was given.
    def full_sha(sha)
      stdout, stderr, status = capture('rev-parse', '--verify', '--end-of-options', "#{sha}^{commit}")
      unless status.success?
        raise Error, "cannot read commit #{sha} here (#{complaint(stderr)}); fetch first if this clone lacks it"
      end

      full = stdout.strip
      raise Error, "#{sha} names a branch or a tag here, not a commit" unless full.start_with?(sha.downcase)

      full
    end

    # Committer time, which for a merge commit is when it landed.
    def commit_time(sha)
      output('show', '-s', '--format=%cI', sha).strip
    end

    # Whether `sha` contains `commit`: true, false, or nil when this
    # clone does not have `sha` to ask about.
    def holds_commit(sha, commit)
      return nil unless capture('cat-file', '-e', "#{sha}^{commit}").last.success?

      _stdout, stderr, status = capture('merge-base', '--is-ancestor', commit, sha)
      return true if status.success?
      return false if status.exitstatus == 1

      raise Error, "git merge-base --is-ancestor failed: #{complaint(stderr)}"
    end

    # The remote-tracking refs that are where the remote's branches are
    # now. A tracking ref records the last fetch. One whose branch the
    # remote has since deleted or moved names commits the remote may not
    # have, and is left out, so those commits count as unpushed.
    def current_tracking_refs
      @current_tracking_refs ||= confirm_tracking_refs
    end

    # Short names, for the report. A tag sharing a branch's name makes
    # the short form ambiguous to rev-list, so default_ahead,
    # unpushed_on, and detached_commits name each branch to git by its
    # full refname.
    def local_branches
      output('for-each-ref', '--format=%(refname)', 'refs/heads/')
        .lines(chomp: true).map { |ref| ref.delete_prefix('refs/heads/') }
    end

    def default_ahead(default)
      tracking = "refs/remotes/#{@remote}/#{default}"
      raise Error, "#{tracking} is absent; fetch #{@remote} first" unless ref?(tracking)
      unless current_tracking_refs.include?(tracking)
        raise Error, "#{tracking} is not where #{@remote} has #{default} now; fetch #{@remote} first"
      end
      return 0 unless ref?("refs/heads/#{default}")

      commits_beyond("refs/heads/#{default}", [tracking])
    end

    def unpushed_on(branch)
      commits_beyond("refs/heads/#{branch}", current_tracking_refs)
    end

    # The commits on a detached HEAD that no local branch and no
    # tracking ref the remote confirms has, and 0 when HEAD is on a
    # branch or names a ref with no commit yet. Worktrees share
    # their refs, so a linked worktree's Git is handed the Git that has
    # asked the remote, which saves a request for each detached
    # worktree.
    def detached_commits(asked = self)
      return 0 unless detached? && commit?('HEAD')

      commits_beyond('HEAD', local_branches.map { |branch| "refs/heads/#{branch}" } + asked.current_tracking_refs)
    end

    def stashes
      output('stash', 'list', '--format=%gd%x00%gs').lines(chomp: true).map { |line| Stash.parse(line) }
    end

    # Every worktree but the one at `here`, each with its branch, how
    # many entries its own status shows, and its detached commits.
    def other_worktrees(here)
      worktree_records.reject { |record| same_directory?(record[:path], here) }
                      .map { |record| read_worktree(record[:path], record[:branch]) }
    end

    private

    def capture(*args, stdin: '')
      stdout, stderr, status = Open3.capture3(CHILD_ENV, 'git', '-C', @dir, *args, stdin_data: stdin)
      [SafeToLeave.utf8(stdout), SafeToLeave.utf8(stderr), status]
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "could not run git: #{e.message}"
    end

    def output(*args, stdin: '')
      stdout, stderr, status = capture(*args, stdin: stdin)
      raise Error, "git #{args.first} failed: #{complaint(stderr)}" unless status.success?

      stdout
    end

    # The first line of what git wrote. The rest repeats it or is
    # advice, and a report line is one line.
    def complaint(stderr)
      stderr.lines.first.to_s.strip
    end

    def confirm_tracking_refs
      prefix = "refs/remotes/#{@remote}/"
      output('for-each-ref', '--format=%(objectname) %(refname)', prefix).lines(chomp: true).filter_map do |line|
        commit, ref = line.split(' ', 2)
        ref if advertised.heads[ref.delete_prefix(prefix)] == commit
      end
    end

    # The remote is asked once. An answer that failed is kept as well,
    # and raised again for each caller.
    def advertised
      @advertised ||= begin
        ask_remote
      rescue Error => e
        e
      end
      raise @advertised if @advertised.is_a?(Error)

      @advertised
    end

    # One question to the remote: which branch is its default, and
    # where each of its branches is.
    def ask_remote
      require_configured_remote
      answer = remote_answer.lines(chomp: true).map { |line| line.split("\t", 2) }
      default = answer.find { |value, ref| ref == 'HEAD' && value.start_with?('ref: refs/heads/') }
      raise Error, "#{@remote} names no default branch" if default.nil?

      heads = answer.select { |_commit, ref| ref.to_s.start_with?('refs/heads/') }
                    .to_h { |commit, ref| [ref.delete_prefix('refs/heads/'), commit] }
      Advertised.new(default.first.delete_prefix('ref: refs/heads/'), heads)
    end

    # `ls-remote`, given `@remote_timeout` seconds. A remote that takes
    # the connection and never answers would otherwise hold the report,
    # and the session running it, for as long as it liked. git runs in a
    # process group of its own so that the transport it started is
    # stopped with it.
    def remote_answer
      command = ['git', '-C', @dir, 'ls-remote', '--symref', @remote, 'HEAD', 'refs/heads/*']
      stdout, stderr, status = SafeToLeave.capture_within(@remote_timeout, CHILD_ENV, command)
      raise Error, "#{@remote} did not answer within #{@remote_timeout}s" if status.nil?
      raise Error, "git ls-remote failed: #{complaint(stderr)}" unless status.success?

      stdout
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "could not run git: #{e.message}"
    end

    # The tracked files `git status` is told not to look at, by the
    # skip-worktree or assume-unchanged mark, whose contents are not
    # what the index holds. `ls-files -v` tags the first with S and the
    # second with a lowercase letter.
    def hidden_changes
      marked = output('ls-files', '-v', '-z').split("\0").filter_map do |entry|
        entry[2..] if entry.match?(/\A(?:S|[a-z]) /)
      end
      return [] if marked.empty?

      indexed = output('ls-files', '-s', '-z', '--', *marked).split("\0").to_h do |entry|
        details, path = entry.split("\t", 2)
        [path, details.split[1]]
      end
      marked.reject { |path| indexed[path] == blob_of(path) }
    end

    # The blob the file would be stored as, and nil when it is missing
    # or cannot be read.
    def blob_of(path)
      stdout, _stderr, status = capture('hash-object', '--', path)
      stdout.strip if status.success?
    end

    # git takes a URL or a path where a remote's name is expected, and
    # would contact whatever it was handed. A name that is not
    # configured is a misspelling.
    def require_configured_remote
      configured = output('remote').lines(chomp: true)
      return if configured.include?(@remote)

      known = configured.empty? ? 'this repository has none' : "configured: #{configured.join(', ')}"
      raise Error, "no such remote: #{@remote} (#{known})"
    end

    def ref?(name)
      capture('show-ref', '--verify', '--quiet', name).last.success?
    end

    # The number of commits reachable from `tip` and from none of
    # `refs`. The refs go in on stdin, since a remote can have more
    # branches than a command line holds.
    def commits_beyond(tip, refs)
      revisions = [tip] + refs.map { |ref| "^#{ref}" }
      Integer(output('rev-list', '--count', '--stdin', stdin: revisions.join("\n")).strip)
    end

    # False for a HEAD that names a ref with no commit yet, which holds
    # no commits to count.
    def commit?(revision)
      capture('rev-parse', '--verify', '--quiet', "#{revision}^{commit}").last.success?
    end

    # Whether HEAD is on no branch. `symbolic-ref -q` exits 1 for a
    # detached HEAD and higher for a failure. It also answers for a HEAD
    # that names a ref outside refs/heads/, whose commits are on no
    # branch either.
    def detached?
      stdout, stderr, status = capture('symbolic-ref', '-q', 'HEAD')
      return !stdout.start_with?('refs/heads/') if status.success?
      raise Error, "git symbolic-ref failed: #{complaint(stderr)}" unless status.exitstatus == 1

      true
    end

    # -z, so a path holding a newline stays one field: fields end with
    # NUL and records with a second one.
    def worktree_records
      output('worktree', 'list', '--porcelain', '-z').split("\0\0").filter_map do |record|
        fields = record.split("\0")
        path = fields.find { |field| field.start_with?('worktree ') }&.delete_prefix('worktree ')
        next if path.nil? || fields.include?('bare')

        # A HEAD that names a ref outside refs/heads/ has a branch field
        # too, and is on no branch.
        branch = fields.find { |field| field.start_with?('branch refs/heads/') }
        { path: path, branch: branch&.delete_prefix('branch refs/heads/') }
      end
    end

    def same_directory?(path, other)
      File.exist?(path) && File.exist?(other) && File.realpath(path) == File.realpath(other)
    end

    def read_worktree(path, branch)
      there = Git.new(dir: path, remote: @remote, remote_timeout: @remote_timeout)
      there.require_worktree_root
      measure_worktree(there, path, branch, there.status_entries.length)
    rescue Error => e
      Worktree.unread(path, branch, e.message)
    end

    # The files have been read by now, and are kept when the commits on
    # a detached HEAD cannot be measured, as when the remote does not
    # answer.
    def measure_worktree(there, path, branch, changes)
      Worktree.read(path, branch, changes: changes, detached_commits: there.detached_commits(self))
    rescue Error => e
      Worktree.unmeasured(path, branch, changes, e.message)
    end
  end

  # Asks GitHub, through its CLI, for the open pull requests and issues,
  # the workflow runs since a time, and single attempts of a run. Every
  # way of not getting an answer raises, so the report can say the line
  # was not checked: an empty list is an answer, and nothing else may be
  # read as one.
  class Host
    # Variables that make gh answer about another repository, or colour
    # its output so that it no longer parses, unset for its children.
    REDIRECTING_ENV_KEYS = %w[GH_REPO CLICOLOR_FORCE GH_FORCE_TTY].freeze

    # Variables that make gh write a trace of its requests to stderr,
    # which is quoted in UNCHECKED lines.
    TRACING_ENV_KEYS = %w[GH_DEBUG DEBUG].freeze

    CHILD_ENV = Git::CHILD_ENV.merge((REDIRECTING_ENV_KEYS + TRACING_ENV_KEYS).to_h { |key| [key, nil] })
                              .merge('NO_COLOR' => '1')
                              .freeze

    # gh's own default is 30, or 20 for runs, and it truncates without
    # saying so.
    LIMIT = 1000

    # The most earlier attempts of one run that are read, one call to gh
    # each.
    ATTEMPT_LIMIT = 20

    OPEN = %w[--state open].freeze
    RUN_FIELDS = %w[databaseId workflowName status conclusion headSha headBranch event attempt].freeze

    def initialize(dir:, repo:, timeout:)
      @dir = dir
      @repo = repo
      @timeout = timeout
    end

    def open_pull_requests
      list('pr', %w[number title headRefName closingIssuesReferences], OPEN)
    end

    def open_issues
      list('issue', %w[number title body], OPEN)
    end

    # The runs a push to `branch` triggered since `stamp`, an ISO 8601
    # time. The listing shows a rerun run by its latest attempt alone.
    def push_runs_since(stamp, branch)
      runs(list('run', RUN_FIELDS, ['--event', Checks::PUSH, '--branch', branch, '--created', ">=#{stamp}"]))
    end

    # Every run since `stamp`, newest first, and whether the listing
    # filled its limit and so may have been cut short.
    def runs_since(stamp)
      records = runs(list('run', RUN_FIELDS, ['--created', ">=#{stamp}"], cut_short: :allowed))
      [records, records.length >= LIMIT]
    end

    # The conclusion of one earlier attempt of a run, which no listing
    # carries.
    def attempt_conclusion(run_id, attempt)
      what = "gh run view #{run_id} --attempt #{attempt}"
      record = answer(what, ['gh', 'run', 'view', run_id.to_s, '--attempt', attempt.to_s, '--json', 'conclusion'])
      raise Error, "#{what} answered with something that is not a record" unless record.is_a?(Hash)

      record['conclusion']
    end

    private

    def list(kind, fields, filter, cut_short: :refused)
      what = "gh #{kind} list"
      records = answer(what, ['gh', kind, 'list', *filter, '--limit', LIMIT.to_s, '--json', fields.join(',')])
      unless records.is_a?(Array) && records.all?(Hash)
        raise Error, "#{what} answered with something that is not a list of records"
      end
      if records.length >= LIMIT && cut_short == :refused
        raise Error, "#{what} returned #{LIMIT} records, its limit, so the list may be cut short"
      end

      records
    end

    # A run's id, its attempt number, and its commit go on to gh and to
    # git as arguments, so each has to be what it is said to be.
    def runs(records)
      records.each do |record|
        shapes = { 'databaseId' => record['databaseId'].is_a?(Integer) && record['databaseId'].positive?,
                   'attempt' => record['attempt'].is_a?(Integer) && record['attempt'].positive?,
                   'headSha' => record['headSha'].to_s.match?(/\A\h{40,64}\z/) }
        field = shapes.key(false)
        raise Error, "gh run list answered with a run whose #{field} is #{record[field].inspect}" if field
      end
    end

    def answer(what, command)
      command += ['--repo', @repo] if @repo
      JSON.parse(run(what, command))
    rescue JSON::ParserError
      raise Error, "#{what} answered with something that is not JSON"
    end

    def run(what, command)
      stdout, stderr, status = SafeToLeave.capture_within(@timeout, CHILD_ENV, command, chdir: @dir)
      raise Error, "#{what} did not answer within #{@timeout}s" if status.nil?
      raise Error, "#{what} failed: #{complaint(stderr)}" unless status.success?

      stdout
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "could not run gh: #{e.message}"
    end

    # The first line gh wrote that says anything. The rest is advice,
    # and a report line is one line.
    def complaint(stderr)
      stderr.lines.map(&:strip).reject(&:empty?).first || 'it gave no reason'
    end
  end

  # Gathers the facts for each check and hands them to Checks.
  # A check whose facts cannot be gathered becomes an UNCHECKED line
  # carrying the reason, and the checks after it still run.
  class Report
    def initialize(git:, host:, here:, prefixes:, issue:, plan_numbers:, merge_commit:)
      @git = git
      @host = host
      @here = here
      @prefixes = prefixes
      @issue = issue
      @plan_numbers = plan_numbers
      @merge_commit = merge_commit
    end

    def lines
      [
        checked('working-tree') { Checks.working_tree(@git.status_entries) },
        checked('in-progress') { Checks.in_progress(@git.operations_in_progress) },
        checked('unpushed') { unpushed },
        checked('stashes') { Checks.stashes(@git.stashes, @prefixes) },
        checked('worktrees') { Checks.worktrees(@git.other_worktrees(@here), @prefixes) },
        checked('pull-requests') { pull_requests },
        checked('issues') { issues },
        checked('workflow-runs') { workflow_runs }
      ].flatten
    end

    private

    def checked(check)
      yield
    rescue Error => e
      [Line.new(check, UNCHECKED, e.message)]
    end

    # With neither a prefix nor an issue there is nothing to tell the
    # story's pull requests by, and gh is not asked.
    def pull_requests
      if @prefixes.empty? && @issue.nil?
        return [Line.new('pull-requests', LISTED, 'not looked for: no --story-branch and no --issue given')]
      end

      Checks.pull_requests(@host.open_pull_requests, prefixes: @prefixes, issue: @issue)
    end

    def issues
      open_issues = @issue ? @host.open_issues : nil
      Checks.issues(open_issues, issue: @issue, prefixes: @prefixes, plan_numbers: @plan_numbers)
    end

    def workflow_runs
      return Checks.workflow_runs(nil, [], default: nil, cut_short: false) if @merge_commit.nil?

      merge = @git.full_sha(@merge_commit)
      stamp = @git.commit_time(merge)
      default = @git.default_branch
      on_default = @host.push_runs_since(stamp, default).map { |record| counted_run(record, merge) }
      others, cut_short = @host.runs_since(stamp)
      elsewhere = others.reject { |record| on_default.any? { |run| run.id == record['databaseId'] } }
                        .map { |record| run_from(record, [latest_conclusion(record)], nil) }
      Checks.workflow_runs(on_default, elsewhere, default: default, cut_short: cut_short)
    end

    # A run that can count has every attempt read, and its commit
    # compared with the merge. The listing carries the latest attempt.
    def counted_run(record, merge)
      earlier = record['attempt'] - 1
      if earlier > Host::ATTEMPT_LIMIT
        raise Error, "run #{record['databaseId']} has #{record['attempt']} attempts, " \
                     "and no more than #{Host::ATTEMPT_LIMIT} earlier ones are read"
      end

      conclusions = (1..earlier).map do |attempt|
        finished(@host.attempt_conclusion(record['databaseId'], attempt))
      end
      run_from(record, conclusions + [latest_conclusion(record)], @git.holds_commit(record['headSha'], merge))
    end

    def run_from(record, conclusions, holds_merge)
      Run.new(id: record['databaseId'], workflow: record['workflowName'], branch: record['headBranch'],
              event: record['event'], status: record['status'], conclusions: conclusions, holds_merge: holds_merge)
    end

    # nil while the run is still going.
    def latest_conclusion(record)
      finished(record['conclusion']) if record['status'] == Checks::COMPLETED
    end

    # A finished attempt that carries no conclusion did not pass.
    def finished(conclusion)
      conclusion.to_s.empty? ? 'no conclusion' : conclusion.to_s
    end

    # How far ahead the default branch is can be unknown while the other
    # branches are still measured, as when its tracking ref is behind
    # the remote. That is an UNCHECKED line of its own, beside whatever
    # the branches show.
    def unpushed
      default = @git.default_branch
      branches = (@git.local_branches - [default]).to_h { |branch| [branch, @git.unpushed_on(branch)] }
      ahead, unknown = default_ahead(default)
      lines = Checks.unpushed(default: default, default_ahead: ahead, detached: @git.detached_commits,
                              branches: branches, prefixes: @prefixes)
      return lines if unknown.nil?

      [Line.new('unpushed', UNCHECKED, unknown)] + lines.reject { |line| line.status == OK }
    end

    def default_ahead(default)
      [@git.default_ahead(default), nil]
    rescue Error => e
      [0, e.message]
    end
  end

  class CLI
    # A value-taking flag swallows a following flag as its value, so
    # each one refuses a value with a leading dash.
    VALUE_NOT_FLAG = /\A[^-].*\z/m

    # Control characters, the Unicode line and paragraph separators, and
    # the format characters, which include the ones that reorder the
    # text around them.
    UNPRINTABLE = /[[:cntrl:]\p{Zl}\p{Zp}\p{Cf}]/

    ISSUE_NUMBER = /\A[1-9]\d*\z/
    COMMIT_SHA = /\A\h{7,64}\z/
    REPOSITORY = %r{\A(?:[^/\s]+/)?[^/\s]+/[^/\s]+\z}

    # Far more than a plan holds.
    PLAN_SIZE_LIMIT = 1_048_576

    # How the detail of a check that was skipped for want of a flag
    # starts.
    NOT_LOOKED_FOR = 'not looked for: '

    def self.run(argv)
      new.run(argv)
    end

    def run(argv)
      options = parse(argv.map { |argument| SafeToLeave.utf8(argument) })
      return puts(USAGE) if options[:help]

      git = Git.new(dir: options[:dir], remote: options[:remote], remote_timeout: options[:remote_timeout])
      host = Host.new(dir: options[:dir], repo: options[:repo], timeout: options[:remote_timeout])
      here = git.toplevel
      lines = Report.new(git: git, host: host, here: here, prefixes: options[:prefixes], issue: options[:issue],
                         plan_numbers: plan_numbers(options[:plan]),
                         merge_commit: options[:merge_commit]).lines
      print_report(here, lines)
      exit 1 if lines.any?(&:against?)
    rescue Error => e
      refuse(e.message)
    # Ruby exits 1 on an exception nothing rescued, and 1 is this
    # command's answer that something counts against leaving.
    rescue StandardError => e
      refuse("unexpected #{e.class}: #{e.message}")
    end

    private

    # A request for usage is answered even beside a stray argument.
    def parse(argv)
      refuse_completion_flags(argv)
      options = { prefixes: [], help: false }
      # permute rather than parse, which stops at the first positional
      # when POSIXLY_CORRECT is set.
      stray = option_parser(options).permute(argv)
      unless stray.empty? || options[:help]
        raise Error, "unexpected extra arguments: #{stray.map(&:inspect).join(', ')}"
      end

      { dir: SafeToLeave.utf8(Dir.pwd), remote: DEFAULT_REMOTE, remote_timeout: DEFAULT_REMOTE_TIMEOUT }.merge(options)
    rescue OptionParser::ParseError => e
      raise Error, e.message
    end

    # OptionParser answers `--*-completion-bash` and
    # `--*-completion-zsh` itself, by printing and exiting 0, and offers
    # no way to turn them off.
    def refuse_completion_flags(argv)
      flag = argv.find { |argument| argument.start_with?('--*') }
      raise Error, "invalid option: #{flag}" if flag
    end

    def option_parser(options)
      OptionParser.new do |o|
        # Abbreviation is off: `--rem` is a typo, and no flag.
        o.require_exact = true
        o.on('-C DIR', VALUE_NOT_FLAG) { |dir| set_once(options, :dir, '-C', dir) }
        o.on('--remote NAME', VALUE_NOT_FLAG) { |name| set_once(options, :remote, '--remote', name) }
        o.on('--remote-timeout SECONDS', Integer) do |seconds|
          raise Error, 'invalid argument: --remote-timeout takes a number of seconds above 0' unless seconds.positive?

          set_once(options, :remote_timeout, '--remote-timeout', seconds)
        end
        o.on('--story-branch PREFIX', VALUE_NOT_FLAG) { |prefix| options[:prefixes] << prefix }
        o.on('--issue NUMBER', VALUE_NOT_FLAG) do |number|
          shaped(number, ISSUE_NUMBER, '--issue takes an issue number, without the #')
          set_once(options, :issue, '--issue', Integer(number))
        end
        o.on('--plan FILE', VALUE_NOT_FLAG) { |file| set_once(options, :plan, '--plan', file) }
        o.on('--merge-commit SHA', VALUE_NOT_FLAG) do |sha|
          shaped(sha, COMMIT_SHA, '--merge-commit takes a commit SHA of 7 or more hex digits')
          set_once(options, :merge_commit, '--merge-commit', sha)
        end
        o.on('--repo [HOST/]OWNER/NAME', VALUE_NOT_FLAG) do |repo|
          shaped(repo, REPOSITORY, '--repo takes [HOST/]OWNER/NAME')
          set_once(options, :repo, '--repo', repo)
        end
        o.on('-h', '--help') { options[:help] = true }
        # OptionParser answers --version itself, by exiting 1. The
        # plugin this ships in has no version to give.
        o.on('--version') { raise Error, 'invalid option: --version' }
      end
    end

    # Taking the last of a repeated single-value flag would report on
    # one of two things the caller named.
    def set_once(options, key, flag, value)
      raise Error, "duplicate #{flag}" if options.key?(key)

      options[key] = value
    end

    def shaped(value, pattern, message)
      raise Error, "invalid argument: #{message}" unless value.match?(pattern)
    end

    # The numbers the plan file mentions, and none when no plan was
    # named. A FIFO or a device would be read without end, so only a
    # regular file of a plan's size is read.
    def plan_numbers(plan)
      return [] if plan.nil?
      raise Error, "the plan file is not a regular file: #{plan}" unless File.file?(plan)
      raise Error, "the plan file is larger than #{PLAN_SIZE_LIMIT} bytes: #{plan}" if File.size(plan) > PLAN_SIZE_LIMIT

      Checks.plan_numbers(SafeToLeave.utf8(File.binread(plan)))
    rescue SystemCallError => e
      raise Error, "could not read the plan file: #{e.message}"
    end

    def print_report(toplevel, lines)
      puts "safe-to-leave: #{printable(toplevel)}"
      lines.each do |line|
        puts format('  %-10<status>s%<check>s: %<detail>s', status: line.status, check: line.check,
                                                           detail: printable(line.detail))
      end
      against = lines.count(&:against?)
      if against.zero?
        puts "safe-to-leave: nothing counts against leaving#{not_looked_for(lines)}"
      else
        puts "safe-to-leave: #{against} #{against == 1 ? 'line counts' : 'lines count'} against leaving"
      end
    end

    # The last line is where a reader takes the answer from, so it names
    # the checks that were never made for want of a flag, and says when
    # no workflow run was there to read.
    def not_looked_for(lines)
      skipped = lines.select { |line| line.detail.start_with?(NOT_LOOKED_FOR) }.map(&:check)
      notes = []
      notes << "not looked for: #{skipped.join(', ')}" unless skipped.empty?
      no_run = lines.any? { |line| line.detail.start_with?(Checks::NO_RUN_FOUND) }
      notes << 'no workflow run found since the merge' if no_run
      notes.map { |note| "; #{note}" }.join
    end

    # File names, stash subjects, worktree paths, and git's messages can
    # hold a newline or a terminal escape, and they are printed inside
    # lines that a reader, or a session, takes as this command's own.
    # Each such character is printed as its Ruby escape.
    def printable(text)
      SafeToLeave.utf8(text).gsub(UNPRINTABLE) { |character| character.dump[1..-2] }
    end

    def refuse(message)
      warn "safe-to-leave: #{printable(message)}"
      exit 2
    end
  end
end

SafeToLeave::CLI.run(ARGV) if $PROGRAM_NAME == __FILE__
