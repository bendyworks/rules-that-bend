# Claude Code local settings and session state are per-machine working
# state, never repo content.
.claude/

# Plans and gauntlet records can name private work, and this repository
# is public. No trailing slash: a parallel checkout's .work is a symlink.
/.work

# direnv per-machine environment (e.g. ITERM_BG_COLOR); never repo content.
.envrc

# SimpleCov output from COVERAGE=1 test runs (see test/coverage_helper.rb).
coverage/

# macOS Finder metadata, written into any directory Finder opens.
.DS_Store
